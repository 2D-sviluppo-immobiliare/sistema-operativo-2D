#!/bin/sh
#
# Configurazione ufficiale di 2D OS.
# Eseguito da `lb build` dentro il container di build.
#
# Modificare qui, non a mano in config/: questo file e' la fonte di verita'.
#
set -e

lb config noauto \
	--mode debian \
	--system live \
	--distribution trixie \
	--architectures amd64 \
	--binary-images iso-hybrid \
	--archive-areas "main contrib non-free-firmware" \
	--mirror-bootstrap "http://deb.debian.org/debian" \
	--mirror-chroot "http://deb.debian.org/debian" \
	--debian-installer none \
	--linux-flavours amd64 \
	--bootloaders "syslinux,grub-efi" \
	--memtest none \
	--firmware-chroot true \
	--firmware-binary false \
	--apt-indices false \
	--apt-recommends true \
	--cache false \
	--chroot-filesystem squashfs \
	--chroot-squashfs-compression-type xz \
	--checksums sha256 \
	--image-name "2d-os" \
	--iso-application "2D OS" \
	--iso-volume "2D_OS_LIVE" \
	--iso-publisher "2D Sviluppo Immobiliare" \
	--bootappend-live "boot=live components quiet splash hostname=2dos locales=it_IT.UTF-8 keyboard-layouts=it tz=Europe/Rome persistence persistence-label=persistence live-config.username=2d live-config.user-fullname=2D live-config.user-default-groups=audio,cdrom,dip,floppy,netdev,plugdev,scanner,sudo,video" \
	--bootappend-live-failsafe "boot=live components quiet nomodeset" \
	"${@}"
