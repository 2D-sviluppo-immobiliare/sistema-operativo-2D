#!/bin/sh
#
# 2D OS - avvio della sessione grafica.
#
# La shell disegna da sola cornici, barre del titolo e pulsanti di chiusura,
# quindi non serve un window manager esterno. Se il motore Qt non e'
# disponibile si ricade sulla shell GTK storica, cosi' il sistema resta
# avviabile anche su un'immagine costruita senza i moduli QML.
set -u

ENGINE="/opt/2d-os/engine"

# In una sessione utente /var/log non e' scrivibile: si usa la home, con
# ripiego su /tmp. Il log serve a capire perche' una sessione non parte.
LOG_DIR="/var/log/2d-os"
if ! mkdir -p "${LOG_DIR}" 2>/dev/null || [ ! -w "${LOG_DIR}" ]; then
    LOG_DIR="${XDG_STATE_HOME:-${HOME:-/tmp}/.local/state}/2d-os"
    if ! mkdir -p "${LOG_DIR}" 2>/dev/null || [ ! -w "${LOG_DIR}" ]; then
        LOG_DIR="/tmp/2d-os-$(id -u)"
        mkdir -p "${LOG_DIR}" 2>/dev/null || true
    fi
fi

if [ -w "${LOG_DIR}" ]; then
    exec >>"${LOG_DIR}/session.log" 2>&1
fi

echo "[2D] avvio sessione $(date -Iseconds)"

export QML_XHR_ALLOW_FILE_READ=1
export QT_QUICK_BACKEND="${QT_QUICK_BACKEND:-}"

# Openbox gestisce le finestre X11 esterne: barra del titolo, spostamento,
# ridimensionamento e chiusura. La shell QML gira a tutto schermo e resta
# sotto; i margini riservati in rc.xml impediscono alle finestre massimizzate
# di coprire i pannelli.
if command -v openbox >/dev/null 2>&1; then
    mkdir -p "${HOME}/.config/openbox" 2>/dev/null || true
    [ -f "${HOME}/.config/openbox/rc.xml" ] || \
        cp /etc/xdg/openbox/2d-rc.xml "${HOME}/.config/openbox/rc.xml" 2>/dev/null || true
    openbox >/dev/null 2>&1 &
    sleep 0.4
fi

if [ -r "${ENGINE}/2d-shell-qml" ]; then
    if python3 -c "import PySide6.QtQuick" >/dev/null 2>&1; then
        exec python3 "${ENGINE}/2d-shell-qml" --boot --fullscreen
    fi
    echo "[2D] PySide6 non disponibile: uso la shell GTK" >&2
fi

if [ -x /usr/lib/2d-os/shell/2d-shell ]; then
    exec /usr/lib/2d-os/shell/2d-shell
fi

echo "[2D] nessuna shell disponibile" >&2
exit 1
