[Desktop Entry]
Type=Application
Version=1.0
Name=Rapporto Hardware 2D
Name[en]=Hardware Report 2D
GenericName=Diagnostica del sistema
Comment=Analizza questa macchina e salva il rapporto
Exec=xfce4-terminal --title="2D - Rapporto hardware" --command="bash -c '2d-hwreport; echo; read -rp \"Premi INVIO per chiudere...\"'"
Icon=utilities-system-monitor
Terminal=false
Categories=System;Utility;
Keywords=hardware;diagnostica;report;2d;
StartupNotify=true
