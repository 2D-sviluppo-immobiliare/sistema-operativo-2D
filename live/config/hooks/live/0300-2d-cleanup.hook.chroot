#!/bin/sh
# 0300-2d-cleanup.hook.chroot
#
# Pulizia finale: riduce la dimensione dell'immagine e le scritture sul supporto.
set -eu

echo "[2D] Pulizia finale"

# I .deb locali sono gia' installati: non devono restare nell'immagine.
rm -rf /opt/2d/packages/*.deb 2>/dev/null || true

# Cache e liste apt
apt-get clean
rm -rf /var/lib/apt/lists/* 2>/dev/null || true

# Log e cache di sistema
rm -rf /var/cache/* /var/log/*.log /var/log/*.gz /var/log/journal 2>/dev/null || true
find /var/log -type f -exec truncate -s 0 {} \; 2>/dev/null || true

# Language pack non necessari al di fuori di italiano e inglese
find /usr/share/locale -mindepth 1 -maxdepth 1 -type d \
     ! -name 'it' ! -name 'it_*' ! -name 'en*' ! -name 'C*' \
     -exec rm -rf {} + 2>/dev/null || true

# Documentazione locale ridondante
rm -rf /usr/share/doc/* 2>/dev/null || true
mkdir -p /usr/share/doc

# Non vogliamo i manuali in 15 lingue
find /usr/share/man -mindepth 1 -maxdepth 1 -type d \
     ! -name 'it' ! -name 'it.*' ! -name 'man0' ! -name 'man1' ! -name 'man2' \
     ! -name 'man3' ! -name 'man4' ! -name 'man5' ! -name 'man6' ! -name 'man7' \
     ! -name 'man8' ! -name 'man9' ! -name 'man1x' ! -name 'man3x' ! -name 'man7x' \
     -exec rm -rf {} + 2>/dev/null || true

echo "[2D] Pulizia completata"
